{
  "name": "country-state-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-16",
  // Production hostname. Its proxied DNS record still points at the old
  // Railway origin, but the route answers every request before it gets there.
  "routes": [{ "pattern": "country-api.drnyeinchan.com/*", "zone_name": "drnyeinchan.com" }],
  // Keep the workers.dev URL so a deploy can be checked outside production.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Drops the .html extension when matching, so v1/countries/AU.html serves at
    // /v1/countries/AU. The extension exists only so a file and a directory can
    // share a name on disk; _headers restores the JSON content-type.
    "html_handling": "auto-trailing-slash",
    // A miss returns 404 to the Worker, which then normalizes the path.
    "not_found_handling": "none",
    // Run the Worker before assets: Cloudflare answers OPTIONS on an asset
    // path with 405 on its own, which breaks browser CORS preflight.
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
